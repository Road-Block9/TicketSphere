# Environment Variables Configuration Example
# Copy this file to .env and fill in the values as appropriate.

# GenAI API Key (Optional: Leave empty to use the built-in deterministic fallback)
# Supported: Google Gemini API (gemini-1.5-flash / gemini-2.0-flash) or OpenAI API
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Mock API Settings
MOCK_API_PORT=8000
MOCK_API_HOST=127.0.0.1
MOCK_API_KEY=

# SQLite Database Location
DATABASE_PATH=data/processed/customer_support.db

# Flask Server & Security Settings
# Flask Debug Mode (Default: false; set to true only for local debugging)
FLASK_DEBUG=false

# Demo Data Reset Endpoint Protection (POST /api/demo/reset)
# Disabled by default. Set to true for local college demonstrations.
ENABLE_DEMO_RESET=false
# Optional authorization secret token required to reset demo data when enabled in deployed environments
DEMO_RESET_TOKEN=

# CORS Configuration
# Comma-separated list of trusted origins (defaults to local Vite ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Size Limit (in bytes; default: 16777216 = 16 MB)
MAX_UPLOAD_SIZE_BYTES=16777216

# Outbound API Ingestion SSRF Protection
# Set to true for local mock server development; set to false in production to block all loopback/private IPs
ALLOW_LOCAL_MOCK_API=true
# Optional comma-separated allowlist of trusted external API hostnames (e.g. api.zendesk.com,api.github.com)
API_ALLOWED_HOSTS=
